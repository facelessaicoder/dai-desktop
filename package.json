{
  "name": "dai-desktop",
  "version": "0.1.0",
  "description": "Local-first AI workspace — standalone Electron app with Ari embedded",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "dependencies": {
    "@types/node": "^22.19.19",
    "apache-arrow": "^21.1.0",
    "better-sqlite3": "^12.10.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.395.0",
    "node-llama-cpp": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "scripts": {
    "bootstrap": "npm install && npm run build:core && npm run build:renderer && npm run build:main",
    "build:core": "npm run build --workspace=packages/dai-core",
    "build:planner": "npm run build --workspace=packages/planner-panel",
    "build:ext": "npm run build --workspace=extensions/dai-ari",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev": "node scripts/dev.js",
    "package": "npm run build:core && npm run build:renderer && npm run build:main && electron-builder",
    "test": "npm run test --workspaces",
    "integration-test": "node --experimental-sqlite --no-warnings=ExperimentalWarning integration_test.mjs",
    "lint": "eslint packages/*/src src/renderer --ext .ts,.tsx"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "ai.dataspheres.dai-desktop",
    "productName": "dai-desktop",
    "copyright": "Copyright © 2026 facelessaicoder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "packages/dai-core/dist/**/*",
      "packages/planner-panel/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packages/planner-panel/dist",
        "to": "packages/planner-panel/dist"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    }
  }
}
